<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <title>Helpdesk</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav>
    <strong>Helpdesk</strong> |
    <% if (locals.user) { %>
        <a href="/tickets">Zgłoszenia</a> |
        <a href="/tickets/new">Nowe zgłoszenie</a> |
        <% if (user.role === 'admin') { %>
            <a href="/admin/users">Użytkownicy</a> |
            <a href="/admin/security">Bezpieczeństwo</a> |
        <% } %>
        Zalogowany: <%= user.username %> (<%= LABELS[user.role] %>) |
        <a href="/account/password">Zmień hasło</a>
        <form method="post" action="/logout" class="inline"><%- include('csrf') %><button>Wyloguj</button></form>
    <% } else { %>
        <a href="/login">Logowanie</a> | <a href="/register">Rejestracja</a>
    <% } %>
</nav>
<hr>
<% if (locals.flash) { %><p class="flash"><%= flash %></p><% } %>
