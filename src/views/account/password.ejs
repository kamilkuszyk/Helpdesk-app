<%- include('../partials/header') %>
<h2>Zmiana hasła</h2>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/account/password">
    <%- include('../partials/csrf') %>
    <p>Obecne hasło: <input name="current" type="password" autocomplete="current-password" required></p>
    <p>Nowe hasło (min. <%= MIN_LENGTH %> znaków, bez loginu): <input name="password" type="password" autocomplete="new-password" required></p>
    <p>Powtórz nowe hasło: <input name="password2" type="password" autocomplete="new-password" required></p>
    <button>Zmień hasło</button>
</form>
<p class="muted">Po zmianie hasła wszystkie inne sesje na Twoim koncie zostaną wylogowane.</p>
<%- include('../partials/footer') %>
