<%- include('partials/header') %>
<h2>Rejestracja</h2>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/register">
    <%- include('partials/csrf') %>
    <p>Login: <input name="username" value="<%= username %>" maxlength="30" required></p>
    <p>Hasło (min. <%= MIN_LENGTH %> znaków, bez loginu): <input name="password" type="password" autocomplete="new-password" required></p>
    <p>Powtórz hasło: <input name="password2" type="password" autocomplete="new-password" required></p>
    <button>Utwórz konto</button>
</form>
<%- include('partials/footer') %>
