# Skopiuj do pliku .env (tylko przy uruchamianiu BEZ Dockera dla aplikacji).
# Plik .env NIE trafia do repozytorium (.gitignore).

# Połączenie z bazą (przy bazie z docker compose: localhost:5433)
DATABASE_URL=postgres://helpdesk:helpdesk_dev@localhost:5433/helpdesk
# true = szyfrowane połączenie z bazą (w chmurze)
DB_SSL=false

# Sekret do podpisywania ciasteczka sesji - w chmurze długi losowy ciąg
SESSION_SECRET=zmien-mnie
# true gdy aplikacja działa za HTTPS
COOKIE_SECURE=false
# 1 = aplikacja stoi za load balancerem / reverse proxy
TRUST_PROXY=
# false = nie wgrywaj kont testowych do pustej bazy (produkcja)
SEED_DEMO_DATA=true

PORT=3000
